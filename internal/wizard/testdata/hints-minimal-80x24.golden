 Dockerfile  flk.toml  flk-run  flk-run.d/prestart  flk-run.d/watch   ctrl+f    
   stdin = "null"     # the app has no console input                            
                                                                                
▌# Backups freeze the VM for the copy (a second or two): the copy holds what    
▌# was on disk, like after a power cut. Fine for apps that write atomically     
▌# or journal; nobody is disconnected.                                          
 [flk.backup]                                                                   
▌  mode = "pause"                                                               
   before_deploy = true                                                         
